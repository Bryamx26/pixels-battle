{
  "name": "pixels-battle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform fighter 2D en pixel art, multijoueur temps réel dans le navigateur.",
  "scripts": {
    "start": "npm run build && npm run serve",
    "build": "vite build",
    "serve": "tsx src/server/index.ts",
    "dev": "concurrently -k -n server,client -c yellow,cyan \"tsx watch src/server/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.ts"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
